  "prepositions": [
    {
      "id": "ag",
      "irish": "ag",
      "english": "at; in possession of",
      "group": "core",
      "notes": "Core preposition for possession: 'tá X ag Y' = Y has X (lit. X is at Y). Also used with verbal nouns to form the progressive: 'tá mé ag ól' = I am drinking.",
      "usage": [
        {"irish": "Tá leabhar agam.", "english": "I have a book."},
        {"irish": "Tá Gaeilge aige.", "english": "He knows Irish (lit. Irish is at him)."},
        {"irish": "Tá siad ag caint.", "english": "They are talking."}
      ],
      "phrases": [
        {"irish": "ag baile", "english": "at home"},
        {"irish": "ag an doras", "english": "at the door"},
        {"irish": "ag an Aifreann", "english": "at Mass"},
        {"irish": "ag bainis", "english": "at a wedding"},
        {"irish": "ag obair", "english": "at work / working"},
        {"irish": "ag dul abhaile", "english": "dying (idiom: going home)"},
        {"irish": "ag iarraidh abhrais", "english": "attempting the impossible (lit. looking for tow)"}
      ],
      "forms": {
        "1sg":   {"f": "agam"},
        "2sg":   {"f": "agat"},
        "3sg_m": {"f": "aige"},
        "3sg_f": {"f": "aici"},
        "1pl":   {"f": "againn"},
        "2pl":   {"f": "agaibh"},
        "3pl":   {"f": "acu"}
      }
    },
    {
      "id": "ar",
      "irish": "ar",
