    {
      "id": "de",
      "irish": "de",
      "english": "of; from; off",
      "group": "core",
      "notes": "Indicates separation, removal, or material/composition. Often found in compound prepositions (de bharr, de réir). Contracts with 'an' → 'den'. Note: 3sg_m and 3sg_f forms are identical to the uninflected preposition.",
      "usage": [
        {"irish": "Thit sé den chathaoir.", "english": "He fell off the chair."},
        {"irish": "De bharr na drochaimsire...", "english": "Because of the bad weather..."},
        {"irish": "Tá sé tuirseach díobh.", "english": "He is tired of them."}
      ],
      "phrases": [
        {"irish": "de ghnáth", "english": "usually / as a rule"},
        {"irish": "de bharr", "english": "because of / as a result of"},
        {"irish": "de réir", "english": "according to"},
        {"irish": "de bhrí", "english": "by reason of / because"},
        {"irish": "de dhíobháil", "english": "for lack of / through want of"},
        {"irish": "de dheoin nó d'ainneoin", "english": "willingly or unwillingly"},
        {"irish": "de ghlór ard", "english": "in a loud voice"},
        {"irish": "de léim", "english": "with a jump / leaping"},
        {"irish": "de do thoil féin", "english": "of your own free will"},
        {"irish": "den duine an t-éadach", "english": "clothes make the man"},
        {"irish": "scoir de", "english": "stop (doing something) / give up"},
        {"irish": "buíoch de", "english": "grateful to / thankful for"}
      ],
